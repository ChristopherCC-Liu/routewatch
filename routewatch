@dataclass(frozen=True)
class UsageEvent:
    source: str
    model: str
    backend: str
    timestamp: float
    calls: int
    prompt: int
    output: int
    cache: int
    file_path: str = ""


def as_int(value: Any) -> int:
    try:
        return max(0, int(value or 0))
    except (TypeError, ValueError, OverflowError):
        return 0


def parse_timestamp(value: Any) -> float | None:
    if isinstance(value, (int, float)):
        # Codex timestamps are ISO strings; tolerate epoch values from adapters.
        return float(value) if value > 100_000_000 else None
    if not isinstance(value, str) or not value:
        return None
    try:
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
        if parsed.tzinfo is None:
            parsed = parsed.astimezone()
        return parsed.timestamp()
    except (ValueError, OverflowError):
        return None


def compact(number: int | float) -> str:
    n = float(number)
    if abs(n) >= 1_000_000_000:
        return f"{n / 1_000_000_000:.1f}B"
    if abs(n) >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if abs(n) >= 10_000:
        return f"{n / 1_000:.0f}k"
    if abs(n) >= 1_000:
        return f"{n / 1_000:.1f}k"
    return f"{int(n):,}"


def short_age(timestamp: float | None, now: float | None = None) -> str:
    if not timestamp:
        return "no records"
    seconds = max(0, int((now or time.time()) - timestamp))
    if seconds < 60:
        return f"{seconds}s ago"
    if seconds < 3600:
        return f"{seconds // 60}m ago"
    if seconds < 86400:
        return f"{seconds // 3600}h ago"
    return f"{seconds // 86400}d ago"


def local_midnight(day: dt.date) -> float:
    return dt.datetime.combine(day, dt.time.min).astimezone().timestamp()


def format_model(value: Any) -> str:
    return value.strip() if isinstance(value, str) and value.strip() else "unknown model"


class FileUsageIndex:
    """Incrementally read local JSONL usage records; never reads message bodies."""

    def __init__(self, codex_root: Path, claude_root: Path, history_days: int):
        self.codex_root = codex_root
        self.claude_root = claude_root
        self.history_days = history_days
        self.events: dict[tuple[str, str], UsageEvent] = {}
        self.file_state: dict[str, dict[str, Any]] = {}
        self.file_keys: dict[str, set[tuple[str, str]]] = defaultdict(set)
        self.file_counts = {"Codex": 0, "Claude Code": 0}
        self.latest = {"Codex": None, "Claude Code": None}
        self.errors = {"Codex": "", "Claude Code": ""}
        self.last_list_refresh = 0.0
        self.file_lists: dict[str, list[Path]] = {"Codex": [], "Claude Code": []}

    def set_history_days(self, days: int) -> None:
        if days > self.history_days:
            self.history_days = days
            self.last_list_refresh = 0

    def _refresh_file_lists(self, now: float) -> None:
        if now - self.last_list_refresh < 10:
            return
        cutoff = now - self.history_days * 86400
        self.last_list_refresh = now
        self.file_counts = {"Codex": 0, "Claude Code": 0}
        for label, root in (("Codex", self.codex_root), ("Claude Code", self.claude_root)):
            found: list[Path] = []
            if root.is_dir():
                try:
                    found = [Path(p) for p in glob.iglob(str(root / "**" / "*.jsonl"), recursive=True)]
                except OSError as exc:
                    self.errors[label] = f"cannot list logs ({type(exc).__name__})"
            selected: list[Path] = []
            for path in found:
                try:
                    stat = path.stat()
                except OSError:
                    continue
                # Active Codex files can live in an old date folder, so mtime also matters.
                if stat.st_mtime >= cutoff:
                    selected.append(path)
                elif label == "Codex":
                    parts = path.parts
                    try:
                        i = parts.index("sessions")
                        folder_day = dt.date(int(parts[i + 1]), int(parts[i + 2]), int(parts[i + 3]))
                        if folder_day >= dt.datetime.fromtimestamp(cutoff).date():
                            selected.append(path)
                    except (ValueError, IndexError, TypeError):
                        pass
            self.file_lists[label] = selected

    def _drop_file(self, path: str) -> None:
        for key in self.file_keys.pop(path, set()):
            self.events.pop(key, None)

    def _add_event(self, path: str, key: tuple[str, str], event: UsageEvent, prefer_richer: bool = False) -> None:
        old = self.events.get(key)
        if old is None or not prefer_richer or (event.output, event.prompt, event.cache, event.timestamp) > (
            old.output, old.prompt, old.cache, old.timestamp
        ):
            self.events[key] = event
        self.file_keys[path].add(key)
        previous = self.latest.get(event.source)
        if previous is None or event.timestamp > previous:
            self.latest[event.source] = event.timestamp

    def _read_complete_lines(self, path: Path, label: str, parser: Any) -> None:
        path_key = str(path)
        try:
            stat = path.stat()
        except OSError:
            return
        state = self.file_state.get(path_key)
        if state is None or stat.st_size < state["offset"] or stat.st_ino != state["inode"] or (
            stat.st_size == state["offset"] and stat.st_mtime_ns != state["mtime_ns"]
        ):
            self._drop_file(path_key)
            state = {"offset": 0, "inode": stat.st_ino, "mtime_ns": stat.st_mtime_ns,
                     "model": "unknown model", "provider": "", "modified": stat.st_mtime}
            self.file_state[path_key] = state
        if stat.st_size == state["offset"] and stat.st_mtime_ns == state["mtime_ns"]:
            return
        try:
            with path.open("rb") as f:
                f.seek(state["offset"])
                data = f.read()
        except OSError:
            return
        last_newline = data.rfind(b"\n")
        if last_newline < 0:
            return
        complete = data[: last_newline + 1]
        state["offset"] += len(complete)
        state["mtime_ns"] = stat.st_mtime_ns
        state["modified"] = stat.st_mtime
        for raw in complete.splitlines():
            if not raw:
                continue
            try:
                record = json.loads(raw)
            except (json.JSONDecodeError, UnicodeDecodeError):
                continue
            try:
                parser(record, path_key, state)
            except (TypeError, ValueError, KeyError, AttributeError):
                continue

    def _parse_codex(self, obj: dict[str, Any], path: str, state: dict[str, Any]) -> None:
        kind = obj.get("type")
        payload = obj.get("payload")
        if not isinstance(payload, dict):
            return
        if kind == "session_meta":
            provider = payload.get("model_provider")
            if isinstance(provider, str) and provider:
                state["provider"] = provider
        elif kind == "turn_context":
            model = payload.get("model") or payload.get("model_name")
            if isinstance(model, str) and model:
                state["model"] = model
            provider = payload.get("model_provider")
            if isinstance(provider, str) and provider:
                state["provider"] = provider
        elif kind == "token_usage_record":
            usage = payload.get("usage")
            timestamp = parse_timestamp(obj.get("timestamp"))
            if not isinstance(usage, dict) or not timestamp:
                return
            prompt = as_int(usage.get("input_tokens"))
            output = as_int(usage.get("output_tokens"))
            cache = as_int(usage.get("cached_input_tokens"))
            if not (prompt or output or cache):
                return
            response_id = payload.get("response_id")
            if not isinstance(response_id, str) or not response_id:
                response_id = f"{timestamp:.6f}:{prompt}:{output}:{cache}"
            provider = state.get("provider") or "Codex"
            event = UsageEvent("Codex", format_model(state.get("model")), provider,
                               timestamp, 1, prompt, output, cache, path)
            self._add_event(path, ("Codex", response_id), event)

    def _parse_claude(self, obj: dict[str, Any], path: str, _state: dict[str, Any]) -> None:
        if obj.get("type") != "assistant":
            return
        message = obj.get("message")
        if not isinstance(message, dict):
            return
        usage = message.get("usage")
        if not isinstance(usage, dict):
            return
        timestamp = parse_timestamp(obj.get("timestamp"))
        if not timestamp:
            return
        raw_input = as_int(usage.get("input_tokens"))
        cache_read = as_int(usage.get("cache_read_input_tokens"))
        cache_write = as_int(usage.get("cache_creation_input_tokens"))
        output = as_int(usage.get("output_tokens"))
        prompt = raw_input + cache_read + cache_write
        if not (prompt or output):
            return
        message_id = message.get("id") or obj.get("uuid")
        if not isinstance(message_id, str) or not message_id:
            message_id = f"{timestamp:.6f}:{prompt}:{output}"
        event = UsageEvent("Claude Code", format_model(message.get("model")), "provider unknown",
                           timestamp, 1, prompt, output, cache_read + cache_write, path)
        # Claude writes an input-only usage row, then a completed row for the same message.
        self._add_event(path, ("Claude Code", message_id), event, prefer_richer=True)

    def update(self, now: float) -> None:
        self._refresh_file_lists(now)
        self.errors = {"Codex": "", "Claude Code": ""}
        for source, parser in (("Codex", self._parse_codex), ("Claude Code", self._parse_claude)):
            files = self.file_lists[source]
            self.file_counts[source] = len(files)
            if not (self.codex_root if source == "Codex" else self.claude_root).exists():
                self.errors[source] = "log directory not found"
                continue
            for path in files:
                self._read_complete_lines(path, source, parser)
        cutoff = now - max(90, self.history_days) * 86400
        expired = [key for key, event in self.events.items() if event.timestamp < cutoff]
        for key in expired:
            self.events.pop(key, None)
            for keys in self.file_keys.values():
                keys.discard(key)
        self.latest = {"Codex": None, "Claude Code": None}
        for event in self.events.values():
            previous = self.latest[event.source]
            if previous is None or event.timestamp > previous:
                self.latest[event.source] = event.timestamp


class HermesUsage:
    def __init__(self, db_path: Path, gateway_path: Path):
        self.db_path = db_path
        self.gateway_path = gateway_path
        self.rows: list[dict[str, Any]] = []
        self.row_count = 0
        self.latest: float | None = None
        self.error = ""
        self.gateway = "unknown"
        self.gateway_age: float | None = None
        self.active_agents = 0
        self._baseline: dict[tuple[Any, ...], tuple[int, int, int, int]] | None = None
        self.rate_events: deque[tuple[float, int, int]] = deque()

    def _read_gateway_state(self, now: float) -> None:
        self.gateway = "unknown"
        self.gateway_age = None
        self.active_agents = 0
        try:
            state = json.loads(self.gateway_path.read_text())
            name = str(state.get("gateway_state", "unknown")).lower()
            updated = parse_timestamp(state.get("updated_at"))
            self.gateway_age = updated
            active = state.get("active_agents", [])
            self.active_agents = len(active) if isinstance(active, (list, dict)) else as_int(active)
            pid = as_int(state.get("pid"))
            alive = False
            if pid:
                try:
                    os.kill(pid, 0)
                    alive = True
                except OSError:
                    alive = False
            # Hermes writes this state at process start rather than as a heartbeat.
            # Keep a live PID marked running for a day and expose the state age in the UI.
            fresh = updated is not None and now - updated < 86400
            if name == "running" and alive and fresh:
                self.gateway = "running"
            elif name == "running":
                self.gateway = "stale"
            else:
                self.gateway = name
        except (OSError, json.JSONDecodeError, AttributeError, TypeError):
            self.gateway = "state unavailable"

    def update(self, now: float) -> None:
        self.error = ""
        self._read_gateway_state(now)
        if not self.db_path.is_file():
            self.error = "state database not found"
            self.rows = []
            return
        try:
            db = sqlite3.connect(f"file:{self.db_path}?mode=ro", uri=True, timeout=0.5)
            db.row_factory = sqlite3.Row
            db.execute("PRAGMA query_only=ON")
            rows = db.execute(
                """SELECT m.session_id, m.model, m.billing_provider, m.billing_mode, m.task,
                          m.api_call_count, m.input_tokens, m.output_tokens,
                          m.cache_read_tokens, m.cache_write_tokens, m.last_seen
                   FROM session_model_usage AS m"""
            ).fetchall()
            db.close()
        except sqlite3.Error as exc:
            self.error = f"state database read failed ({type(exc).__name__})"
            return
        clean: list[dict[str, Any]] = []
        current: dict[tuple[Any, ...], tuple[int, int, int, int]] = {}
        latest: float | None = None
        for row in rows:
            item = dict(row)
            item["model"] = format_model(item.get("model"))
            item["billing_provider"] = str(item.get("billing_provider") or "unknown provider")
            item["billing_mode"] = str(item.get("billing_mode") or "")
            item["task"] = str(item.get("task") or "")
            for k in ("api_call_count", "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens"):
                item[k] = as_int(item.get(k))
            item["last_seen"] = float(item.get("last_seen") or 0)
            clean.append(item)
            timestamp = item["last_seen"]
            if timestamp and (latest is None or timestamp > latest):
                latest = timestamp
            key = (item.get("session_id"), item["model"], item["billing_provider"], item["billing_mode"], item["task"])
            current[key] = (
                item["input_tokens"] + item["cache_read_tokens"] + item["cache_write_tokens"],
                item["output_tokens"], item["cache_read_tokens"] + item["cache_write_tokens"],
                item["api_call_count"],
            )
        if self._baseline is not None:
            for key, values in current.items():
                previous = self._baseline.get(key, (0, 0, 0, 0))
                dp, dout = values[0] - previous[0], values[1] - previous[1]
                if dp > 0 or dout > 0:
                    self.rate_events.append((now, max(0, dp), max(0, dout)))
        self._baseline = current
        while self.rate_events and now - self.rate_events[0][0] > 60:
            self.rate_events.popleft()
        self.rows = clean
        self.row_count = len(clean)
        self.latest = latest

    def recent_rate(self, now: float, uptime: float) -> tuple[float, float]:
        prompt = sum(item[1] for item in self.rate_events)
        output = sum(item[2] for item in self.rate_events)
        seconds = max(1.0, min(60.0, uptime))
        return prompt / seconds, output / seconds


class RouteWatch:
    def __init__(self, args: argparse.Namespace):
        self.days = args.days
        self.index = FileUsageIndex(args.codex_dir, args.claude_dir, max(30, args.days * 2))
        self.hermes = HermesUsage(args.hermes_db, args.hermes_state)
        self.refresh = max(1, args.refresh)
        self.started = time.time()
        self.lock = threading.RLock()
        self.stop_event = threading.Event()
        self.first_pass_done = threading.Event()
        self.last_scan = 0.0
        self.wake_event = threading.Event()
        self.collection_error = ""
        self.published = {
            "events": (), "hermes_rows": (), "hermes_rates": (),
            "source_status": {
                name: {"files": 0, "latest": None, "error": "indexing"}
                for name in ("Codex", "Claude Code", "Hermes")
            },
        }
        self.published["source_status"]["gateway"] = {"state": "loading", "latest": None, "agents": 0}
        self.worker = threading.Thread(target=self._background_update, name="routewatch-index", daemon=True)
        self.worker.start()

    def _background_update(self) -> None:
        # Only this worker mutates the indexes. Rendering reads published snapshots.
        while not self.stop_event.is_set():
            self.wake_event.clear()
            try:
                now = time.time()
                history_days = max(30, self.days * 2)
                self.index.set_history_days(history_days)
                self.index.update(now)
                self.hermes.update(time.time())
                published = {
                    "history_days": history_days,
                    "events": tuple(self.index.events.values()),
                    "hermes_rows": tuple(self.hermes.rows),
                    "hermes_rates": tuple(self.hermes.rate_events),
                    "source_status": {
                        "Codex": {"files": self.index.file_counts["Codex"], "latest": self.index.latest["Codex"], "error": self.index.errors["Codex"]},
                        "Claude Code": {"files": self.index.file_counts["Claude Code"], "latest": self.index.latest["Claude Code"], "error": self.index.errors["Claude Code"]},
                        "Hermes": {"files": self.hermes.row_count, "latest": self.hermes.latest, "error": self.hermes.error},
                        "gateway": {"state": self.hermes.gateway, "latest": self.hermes.gateway_age, "agents": self.hermes.active_agents},
                    },
                }
                with self.lock:
                    self.published = published
                    self.last_scan = time.time()
                    self.collection_error = ""
            except Exception as exc:
                with self.lock:
                    self.collection_error = f"Collector error: {type(exc).__name__}: {exc}"
            finally:
                self.first_pass_done.set()
            self.wake_event.wait(self.refresh)

    def set_days(self, days: int) -> None:
        self.days = days
        self.request_refresh()

    def request_refresh(self) -> None:
        self.index.last_list_refresh = 0
        self.wake_event.set()

    def snapshot(self, now: float | None = None, source: str = "All") -> dict[str, Any]:
        now = now or time.time()
        today = dt.datetime.fromtimestamp(now).date()
        start_day = today - dt.timedelta(days=self.days - 1)
        start_ts = local_midnight(start_day)
        previous_start = local_midnight(start_day - dt.timedelta(days=self.days))
        with self.lock:
            published = self.published
            last_scan = self.last_scan
            collection_error = self.collection_error
        events = published["events"]
        hermes_rows = published["hermes_rows"]
        statuses = published["source_status"]
        live_deltas = [v for v in published["hermes_rates"] if now - 60 <= v[0] <= now]
        seconds = max(1.0, min(60.0, now - self.started))
        hermes_rate = (sum(v[1] for v in live_deltas) / seconds,
                       sum(v[2] for v in live_deltas) / seconds)

        selected: list[UsageEvent] = [e for e in events if start_ts <= e.timestamp <= now and (source == "All" or e.source == source)]
        prev_records: list[UsageEvent] = [e for e in events if previous_start <= e.timestamp < start_ts and (source == "All" or e.source == source)]
        for row in (hermes_rows if source in ("All", "Hermes") else ()):
            timestamp = row["last_seen"]
            if start_ts <= timestamp <= now:
                provider = row["billing_provider"]
                backend = provider + (f"/{row['billing_mode']}" if row["billing_mode"] else "")
                if row["task"]:
                    backend += f"/{row['task']}"
                selected.append(UsageEvent(
                    "Hermes", row["model"], backend, timestamp, row["api_call_count"],
                    row["input_tokens"] + row["cache_read_tokens"] + row["cache_write_tokens"],
                    row["output_tokens"], row["cache_read_tokens"] + row["cache_write_tokens"],
                ))
            elif previous_start <= timestamp < start_ts:
                provider = row["billing_provider"]
                backend = provider + (f"/{row['billing_mode']}" if row["billing_mode"] else "")
                if row["task"]:
                    backend += f"/{row['task']}"
                prev_records.append(UsageEvent(
                    "Hermes", row["model"], backend, timestamp, row["api_call_count"],
                    row["input_tokens"] + row["cache_read_tokens"] + row["cache_write_tokens"],
                    row["output_tokens"], row["cache_read_tokens"] + row["cache_write_tokens"],
                ))

        def totals(records: list[UsageEvent]) -> dict[str, int]:
            return {"calls": sum(e.calls for e in records), "prompt": sum(e.prompt for e in records),
                    "output": sum(e.output for e in records), "cache": sum(e.cache for e in records)}

        current = totals(selected)
        previous = totals(prev_records)
        routes: dict[tuple[str, str, str], dict[str, Any]] = {}
        source_totals: dict[str, dict[str, int]] = defaultdict(lambda: {"calls": 0, "prompt": 0, "output": 0, "cache": 0})
        daily: dict[dt.date, dict[str, int]] = defaultdict(lambda: {"prompt": 0, "output": 0, "calls": 0, "cache": 0})
        hourly = defaultdict(lambda: {"prompt": 0, "output": 0, "calls": 0, "cache": 0})
        latest_routes: dict[str, UsageEvent] = {}
        for event in selected:
            key = (event.source, event.model, event.backend)
            route = routes.setdefault(key, {"source": event.source, "model": event.model, "backend": event.backend,
                                            "calls": 0, "prompt": 0, "output": 0, "cache": 0, "latest": 0})
            for field in ("calls", "prompt", "output", "cache"):
                route[field] += getattr(event, field)
                source_totals[event.source][field] += getattr(event, field)
            route["latest"] = max(route["latest"], event.timestamp)
            day = dt.datetime.fromtimestamp(event.timestamp).date()
            if start_day <= day <= today:
                daily[day]["prompt"] += event.prompt
                daily[day]["output"] += event.output
                daily[day]["calls"] += event.calls
                daily[day]["cache"] += event.cache
                hour = dt.datetime.fromtimestamp(event.timestamp).hour
                for metric in ("prompt", "output", "calls", "cache"):
                    hourly[hour][metric] += getattr(event, metric)
            old = latest_routes.get(event.source)
            if old is None or event.timestamp > old.timestamp:
                latest_routes[event.source] = event

        route_list = sorted(routes.values(), key=lambda r: (r["prompt"] + r["output"], r["calls"]), reverse=True)
        days = []
        for offset in range(self.days):
            day = start_day + dt.timedelta(days=offset)
            days.append({"date": day, **daily[day]})

        rate_by_source: dict[str, dict[str, float]] = defaultdict(lambda: {"prompt": 0.0, "output": 0.0})
        for source_name in ("Codex", "Claude Code", "Hermes"):
            rate_by_source[source_name]
        for event in events:
            if now - 60 <= event.timestamp <= now + 5:
                rate_by_source[event.source]["prompt"] += event.prompt
                rate_by_source[event.source]["output"] += event.output
        rate_by_source["Hermes"]["prompt"] += hermes_rate[0] * 60
        rate_by_source["Hermes"]["output"] += hermes_rate[1] * 60
        rate_values = [v for k, v in rate_by_source.items() if source == "All" or k == source]
        rate = {"prompt": sum(v["prompt"] for v in rate_values) / 60,
                "output": sum(v["output"] for v in rate_values) / 60,
                "sources": {k: {"prompt_per_sec": v["prompt"] / 60, "output_per_sec": v["output"] / 60}
                            for k, v in rate_by_source.items()}}
        if self.days == 1:
            timeline = [{"label": f"{hour:02d}:00", **hourly[hour]}
                        for hour in range(dt.datetime.fromtimestamp(now).hour + 1)]
        else:
            timeline = [{"label": str(day["date"]), **{k: day[k] for k in ("prompt", "output", "calls", "cache")}}
                        for day in days]
        for bucket in timeline:
            bucket["total"] = bucket["prompt"] + bucket["output"]
        return {"now": now, "days": self.days, "source_filter": source,
                "timeline": timeline, "last_scan": last_scan, "collection_error": collection_error, "start_day": start_day, "end_day": today,
                "totals": current, "previous": previous, "routes": route_list,
                "sources": dict(source_totals), "source_status": statuses,
                "latest_routes": latest_routes, "daily": days, "rate": rate,
                "indexing": not self.first_pass_done.is_set() or published.get("history_days", 0) < max(30, self.days * 2)}


def pct_change(current: int, previous: int) -> str:
    if previous <= 0:
        return "new" if current > 0 else "flat"
    change = (current - previous) / previous * 100
    return f"{change:+.0f}%"


def sparkline(values: list[int], width: int) -> str:
    blocks = "▁▂▃▄▅▆▇█"
    if width <= 0:
        return ""
    if not values:
        return " " * width
    if len(values) > width:
        # Keep the maximum in each bucket so short spikes remain visible.
        grouped = []
        for i in range(width):
            lo = int(i * len(values) / width)
            hi = max(lo + 1, int((i + 1) * len(values) / width))
            grouped.append(max(values[lo:hi] or [0]))
        values = grouped
    elif len(values) < width:
        values = [0] * (width - len(values)) + values
    maximum = max(values) if values else 0
    if maximum <= 0:
        return "·" * width
    return "".join(blocks[min(7, int(v / maximum * 7))] for v in values)


def trend_spark(values: list[int], width: int) -> str:
    if len(values) <= width:
        return sparkline(values, len(values))
    return sparkline(values, width)


def print_snapshot(app: RouteWatch) -> None:
    app.first_pass_done.wait()
    snap = app.snapshot()
    totals = snap["totals"]
    cache_pct = totals["cache"] / totals["prompt"] * 100 if totals["prompt"] else 0
    print("ROUTEWATCH | GLOBAL MODEL ROUTING + TOKEN ANALYTICS")
    print(f"Window: {snap['days']} {'day' if snap['days'] == 1 else 'days'} ({snap['start_day']} to {snap['end_day']}) | Updated: {dt.datetime.fromtimestamp(snap['now']).astimezone().strftime('%Y-%m-%d %H:%M:%S %Z')}")
    statuses = snap["source_status"]
    for name in ("Codex", "Claude Code", "Hermes"):
        item = statuses[name]
        issue = f" — {item['error']}" if item.get("error") else ""
        unit = "routes" if name == "Hermes" else "files"
        print(f"{name:12} {item['files']:>5} {unit} | latest {short_age(item['latest'], snap['now'])}{issue}")
    print(f"Hermes gateway: {statuses['gateway']['state']} | state {short_age(statuses['gateway']['latest'], snap['now'])} | active agents: {statuses['gateway']['agents']}")
    print(f"Calls: {totals['calls']:,} | Prompt: {compact(totals['prompt'])} | Output: {compact(totals['output'])} | Cache: {compact(totals['cache'])} ({cache_pct:.0f}% of prompt)")
    p = snap["previous"]
    print(f"Compared with previous {snap['days']}d: prompt {pct_change(totals['prompt'], p['prompt'])}, output {pct_change(totals['output'], p['output'])}, calls {pct_change(totals['calls'], p['calls'])}")
    rate = snap["rate"]
    print(f"Recent recorded rate (last 60s): {(rate['prompt'] + rate['output']):.1f} tok/s total | prompt {rate['prompt']:.1f}/s, output {rate['output']:.1f}/s")
    source_rate = " | ".join(f"{name} {(value['prompt_per_sec'] + value['output_per_sec']):.1f}/s"
                             for name, value in sorted(rate["sources"].items()))
    print(f"By source: {source_rate or 'no recent usage records'}")
    print("Rate counts completed usage records; it is not live streaming TPS. Hermes rate starts after this monitor observes an update.")
    print("\nROUTES (largest token volume first)")
    print(f"{'SOURCE':12} {'MODEL':26} {'BACKEND / MODE':34} {'CALLS':>8} {'PROMPT':>10} {'OUTPUT':>9} {'CACHE':>9}")
    for route in snap["routes"][:20]:
        print(f"{route['source'][:12]:12} {route['model'][:26]:26} {route['backend'][:34]:34} {route['calls']:>8,} {compact(route['prompt']):>10} {compact(route['output']):>9} {compact(route['cache']):>9}")
    unit = "hour" if snap["days"] == 1 else "day"
    heading = "HOURLY" if unit == "hour" else "DAILY"
    print(f"\n{heading} TREND (Hermes session totals assigned to last activity)")
    for key in ("prompt", "output", "calls"):
        vals = [bucket[key] for bucket in snap["timeline"]]
        print(f"{key.capitalize():8} {trend_spark(vals, 50)}  {compact(max(vals, default=0))} peak/{unit}")
    print("\nRun `routewatch` for the interactive terminal dashboard; `routewatch --help` for options.")


def safe_add(stdscr: Any, y: int, x: int, text: str, attr: int = 0) -> None:
    height, width = stdscr.getmaxyx()
    if y < 0 or y >= height or x >= width:
        return
    text = "".join(c if c.isprintable() else " " for c in str(text))
    clipped = text[: max(0, width - x - 1)]
    try:
        stdscr.addstr(y, x, clipped, attr)
    except curses.error:
        pass


class DashboardUI:
    VIEWS = ("Overview", "Routes", "Trends", "Sources")
    SOURCES = ("All", "Codex", "Claude Code", "Hermes")
    SORTS = ("total", "output", "calls", "latest", "cache")
    METRICS = ("total", "prompt", "output", "cache", "calls")

    def __init__(self, app: RouteWatch):
        self.app = app
        self.view = self.source = self.sort = self.metric = self.selected = 0
        self.cursor = None
        self.selected_key = None
        self.query = ""
        self.old_query = ""
        self.searching = self.paused = self.details = self.help = False
        self.needs_snapshot = True
        self.routes = []
        self.hits = []
        self.accent = curses.A_BOLD
        self.dim = curses.A_DIM
        self.good = curses.A_BOLD
        self.note = ""

    @staticmethod
    def route_key(route):
        return route["source"], route["model"], route["backend"]

    def button(self, screen, y, x, label, action, value=None, active=False):
        text = f" {label} "
        safe_add(screen, y, x, text, curses.A_REVERSE | curses.A_BOLD if active else self.accent)
        self.hits.append((y, x, len(text), action, value))
        return x + len(text) + 1

    def route_rows(self, snap):
        rows = [r for r in snap["routes"] if self.query.casefold() in
                " ".join((r["source"], r["model"], r["backend"])).casefold()]
        metric = self.SORTS[self.sort]
        rows.sort(key=lambda r: (r["prompt"] + r["output"] if metric == "total" else r[metric],
                                 r["model"], r["backend"]), reverse=True)
        if self.selected_key is not None:
            self.selected = next((i for i, r in enumerate(rows) if self.route_key(r) == self.selected_key), self.selected)
        self.selected = min(max(0, self.selected), max(0, len(rows) - 1))
        self.routes = rows
        self.selected_key = self.route_key(rows[self.selected]) if rows else None
        return rows

    def move_route(self, step):
        self.selected = min(max(0, self.selected + step), max(0, len(self.routes) - 1))
        self.selected_key = self.route_key(self.routes[self.selected]) if self.routes else None

    def dispatch(self, action, value=None):
        if action == "view":
            self.view = value
            self.details = False
        elif action == "days":
            self.app.set_days(value)
            self.cursor = None
            self.paused = False
            self.needs_snapshot = True
        elif action in ("source", "source_focus"):
            self.source = (self.source + 1) % len(self.SOURCES) if value is None else value
            self.selected_key = None
            self.selected = 0
            self.paused = False
            self.needs_snapshot = True
            if action == "source_focus":
                self.view = 0
        elif action == "sort":
            self.sort = (self.sort + 1) % len(self.SORTS)
            self.selected_key = None
            self.selected = 0
        elif action == "metric":
            self.metric = (self.metric + 1) % len(self.METRICS)
        elif action == "pause":
            self.paused = not self.paused
            self.needs_snapshot = not self.paused
        elif action == "route":
            self.selected = value
            self.selected_key = self.route_key(self.routes[value])
        elif action == "cursor":
            self.cursor = value
        elif action == "help":
            self.help = not self.help
        elif action == "close":
            self.details = self.help = False
        elif action == "refresh":
            self.app.request_refresh()
            self.paused = False
            self.needs_snapshot = True
            self.note = "Refresh requested"

    def handle(self, key, snap):
        if self.searching:
            if key in (10, 13, curses.KEY_ENTER):
                self.searching = False
            elif key == 27:
                self.query = self.old_query
                self.searching = False
            elif key in (curses.KEY_BACKSPACE, 127, 8):
                self.query = self.query[:-1]
            elif 32 <= key <= 126:
                self.query += chr(key)
            self.selected_key = None
            self.selected = 0
            return True
        if key in (ord('q'), ord('Q')):
            return False
        if key == 27:
            if self.details or self.help:
                self.details = self.help = False
            else:
                self.query = ""
            return True
        if key == ord('?'):
            self.help = not self.help
            return True
        if key == curses.KEY_MOUSE:
            try:
                _, mx, my, _, buttons = curses.getmouse()
                if buttons & getattr(curses, 'BUTTON4_PRESSED', 0):
                    self.move_route(-1)
                elif buttons & getattr(curses, 'BUTTON5_PRESSED', 0):
                    self.move_route(1)
                elif buttons & (getattr(curses, 'BUTTON1_CLICKED', 0) |
                                getattr(curses, 'BUTTON1_DOUBLE_CLICKED', 0) |
                                getattr(curses, 'BUTTON1_RELEASED', 0)):
                    for y, x, width, action, value in reversed(self.hits):
                        if my == y and x <= mx < x + width:
                            self.dispatch(action, value)
                            if action == "route" and buttons & getattr(curses, 'BUTTON1_DOUBLE_CLICKED', 0):
                                self.details = True
                            break
            except curses.error:
                pass
            return True
        if self.help or self.details:
            if key in (10, 13, curses.KEY_ENTER):
                self.details = self.help = False
            return True
        if key in (9, curses.KEY_BTAB):
            self.dispatch("view", (self.view + (-1 if key == curses.KEY_BTAB else 1)) % 4)
        elif key in tuple(map(ord, '1234')):
            self.dispatch("days", (1, 7, 30, 90)[key - ord('1')])
        elif key == ord('f'):
            self.dispatch("source")
        elif key == ord('s'):
            self.dispatch("sort")
        elif key == ord('m'):
            self.dispatch("metric")
        elif key in (ord(' '), ord('p')):
            self.dispatch("pause")
        elif key == ord('r'):
            self.dispatch("refresh")
        elif key == ord('/'):
            self.view = 1
            self.old_query = self.query
            self.searching = True
        elif key == ord('x'):
            self.query = ""
            self.dispatch("source", 0)
        elif key in (10, 13, curses.KEY_ENTER) and self.view in (0, 1) and self.routes:
            self.details = True
        elif self.view == 2:
            end = len(snap['timeline']) - 1
            cursor = end if self.cursor is None else self.cursor
            if key in (curses.KEY_LEFT, ord('h')):
                self.cursor = max(0, cursor - 1)
            elif key in (curses.KEY_RIGHT, ord('l')):
                self.cursor = min(end, cursor + 1)
            elif key == curses.KEY_HOME:
                self.cursor = 0
            elif key == curses.KEY_END:
                self.cursor = end
        elif self.view in (0, 1):
            if key in (curses.KEY_UP, ord('k')):
                self.move_route(-1)
            elif key in (curses.KEY_DOWN, ord('j')):
                self.move_route(1)
            elif key == curses.KEY_NPAGE:
                self.move_route(8)
            elif key == curses.KEY_PPAGE:
                self.move_route(-8)
            elif key == curses.KEY_HOME:
                self.move_route(-len(self.routes))
            elif key == curses.KEY_END:
                self.move_route(len(self.routes))
        return True

    def table(self, screen, snap, top, bottom):
        _, width = screen.getmaxyx()
        rows = self.route_rows(snap)
        model_width = max(16, width - 52)
        safe_add(screen, top, 2, f"{'SOURCE':11} {'MODEL':{model_width}} {'CALLS':>7} {'TOTAL':>9} {'OUTPUT':>8}", self.dim)
        count = max(1, bottom - top - 1)
        start = max(0, min(self.selected - count + 1, len(rows) - count))
        for offset, route in enumerate(rows[start:start + count]):
            index = start + offset
            y = top + 1 + offset
            text = f"{route['source']:11} {route['model'][:model_width]:{model_width}} {compact(route['calls']):>7} {compact(route['prompt'] + route['output']):>9} {compact(route['output']):>8}"
            selected = index == self.selected
            safe_add(screen, y, 1, (' ' + text).ljust(width - 3), curses.A_REVERSE if selected else 0)
            self.hits.append((y, 1, width - 3, "route", index))
        if not rows:
            safe_add(screen, top + 2, 3, "No matching routes. Press x to clear filters.", self.dim)
        return len(rows)

    def modal(self, screen, title, lines):
        import textwrap
        height, width = screen.getmaxyx()
        box_width = min(90, width - 6)
        wrapped = []
        for line in lines:
            wrapped.extend(textwrap.wrap(line, box_width - 6) or [''])
        box_height = min(height - 4, len(wrapped) + 4)
        y, x = (height - box_height) // 2, (width - box_width) // 2
        self.hits = []
        for row in range(box_height):
            safe_add(screen, y + row, x, ' ' * box_width, curses.A_REVERSE)
        safe_add(screen, y, x, '+' + '-' * (box_width - 2) + '+', self.accent)
        safe_add(screen, y + 1, x + 2, title, curses.A_BOLD | curses.A_REVERSE)
        self.button(screen, y + 1, x + box_width - 9, 'close', 'close')
        for row, line in enumerate(wrapped[:box_height - 4]):
            safe_add(screen, y + 3 + row, x + 2, line, curses.A_REVERSE)
        safe_add(screen, y + box_height - 1, x, '+' + '-' * (box_width - 2) + '+', self.accent)

    def render(self, screen, snap):
        height, width = screen.getmaxyx()
        layout = (height, width, self.view, self.source, self.sort, self.metric,
                  self.query, self.details, self.help, snap['days'])
        if getattr(self, '_layout', None) != layout:
            screen.clear()
            self._layout = layout
        else:
            screen.erase()
        self.hits = []
        if width < 72 or height < 22:
            safe_add(screen, 0, 0, "ROUTEWATCH | Enlarge terminal to at least 72 x 22.", self.accent)
            safe_add(screen, 2, 0, "q: quit | current size " + str(width) + " x " + str(height))
            screen.refresh()
            return
        state = "PAUSED" if self.paused else "INDEXING" if snap['indexing'] else "LIVE"
        stamp = dt.datetime.fromtimestamp(snap['now']).strftime('%H:%M:%S')
        safe_add(screen, 0, 2, "ROUTEWATCH  /  GLOBAL MODEL TELEMETRY", self.accent)
        safe_add(screen, 0, width - 22, f"{state:8} {stamp}", self.good)
        x = 1
        for i, label in enumerate(self.VIEWS):
            x = self.button(screen, 1, x, label, 'view', i, i == self.view)
        self.button(screen, 1, width - 5, '?', 'help')
        x = 1
        for i, days in enumerate((1, 7, 30, 90)):
            x = self.button(screen, 2, x, f'{i+1}:{days}d', 'days', days, snap['days'] == days)
        x = self.button(screen, 2, x, f'f:{self.SOURCES[self.source]}', 'source')
        self.button(screen, 2, x, 'resume' if self.paused else 'pause', 'pause', active=self.paused)
        safe_add(screen, 3, 1, '─' * (width - 3), self.dim)
        totals = snap['totals']
        total = totals['prompt'] + totals['output']
        share = totals['cache'] / totals['prompt'] * 100 if totals['prompt'] else 0
        card_width = (width - 4) // 3
        cards = [('TOKENS', compact(total), f"Prompt {compact(totals['prompt'])} / Out {compact(totals['output'])}"),
                 ('CALLS / CACHE', compact(totals['calls']), f"Cache {compact(totals['cache'])} ({share:.1f}%)"),
                 ('RECORDED RATE / 60s', f"{snap['rate']['prompt'] + snap['rate']['output']:,.1f}/s", f"Output {snap['rate']['output']:,.1f}/s")]
        for i, (label, value, detail) in enumerate(cards):
            x = 2 + i * card_width
            safe_add(screen, 4, x, label[:card_width - 1], self.dim)
            safe_add(screen, 5, x, value, self.accent)
            safe_add(screen, 6, x, detail[:card_width - 1])
        safe_add(screen, 7, 1, '─' * (width - 3), self.dim)
        if self.view == 0:
            safe_add(screen, 8, 2, 'SOURCE SHARE', self.accent)
            bar_width = max(6, width - 56)
            for i, name in enumerate(self.SOURCES[1:]):
                metrics = snap['sources'].get(name, {})
                amount = metrics.get('prompt', 0) + metrics.get('output', 0)
                ratio = amount / total if total else 0
                rate = snap['rate']['sources'].get(name, {})
                source_rate = rate.get('prompt_per_sec', 0) + rate.get('output_per_sec', 0)
                bar = '█' * round(ratio * bar_width)
                if self.source and name != self.SOURCES[self.source]:
                    safe_add(screen, 9 + i, 2, f"{name:11} Outside filter - click to inspect", self.dim)
                else:
                    safe_add(screen, 9 + i, 2, f"{name:11} {bar:<{bar_width}} {ratio:5.1%} {compact(amount):>8} {source_rate:>9,.1f}/s")
                self.hits.append((9 + i, 2, width - 5, 'source_focus', i + 1))
            values = [v['total'] for v in snap['timeline']]
            unit = 'hourly today' if snap['days'] == 1 else 'daily'
            safe_add(screen, 13, 2, f"{unit:12} {trend_spark(values, width - 31)}", self.accent)
            self.hits.append((13, 2, width - 5, 'view', 2))
            safe_add(screen, 14, 2, 'ROUTES  /  Enter for details', self.dim)
            self.table(screen, snap, 15, height - 3)
        elif self.view == 1:
            count = len(self.route_rows(snap))
            self.button(screen, 8, 1, f's:sort {self.SORTS[self.sort]}', 'sort')
            safe_add(screen, 8, 27, f"{count} routes | / search: {self.query or 'all'}", self.accent)
            self.table(screen, snap, 9, height - 3)
        elif self.view == 2:
            self.trend(screen, snap)
        else:
            self.sources(screen, snap)
        hints = ("Tab views | f source | 1-4 period | j/k select | Enter details",
                 "j/k scroll | PgUp/PgDn | Enter details | / search | s sort | x reset",
                 "Left/Right inspect | Home/End | m metric | click a bar",
                 "Click a source to inspect its usage | r refresh")[self.view]
        safe_add(screen, height - 3, 1, '─' * (width - 3), self.dim)
        safe_add(screen, height - 2, 1, hints, self.accent)
        note = self.app.collection_error or self.note or 'Space pause | ? help | q quit | Completed records; streaming TPS unavailable'
        safe_add(screen, height - 1, 1, note, self.dim)
        if self.searching:
            safe_add(screen, height - 1, 1, (f"Search: {self.query}_   Enter apply / Esc cancel").ljust(width - 2), curses.A_REVERSE)
        if self.details and self.routes:
            route = self.routes[self.selected]
            volume = route['prompt'] + route['output']
            ratio = route['cache'] / route['prompt'] * 100 if route['prompt'] else 0
            lines = [f"Source: {route['source']}", f"Model: {route['model']}", f"Backend / mode / task: {route['backend']}", '',
                     f"Calls: {route['calls']:,}     Total tokens: {volume:,}",
                     f"Prompt: {route['prompt']:,}     Output: {route['output']:,}",
                     f"Cache: {route['cache']:,} ({ratio:.1f}% of prompt)",
                     f"Mean tokens / call: {volume / route['calls']:,.0f}" if route['calls'] else 'Mean tokens / call: unavailable',
                     f"Last recorded: {dt.datetime.fromtimestamp(route['latest']).astimezone().strftime('%Y-%m-%d %H:%M:%S %Z')}",
                     'Hermes values are session aggregates assigned to last activity.' if route['source'] == 'Hermes' else
                     'Claude provider is not included in local usage records.' if route['source'] == 'Claude Code' else
                     'Model/provider come from Codex session context.',
                     'Esc / Enter: close']
            self.modal(screen, 'ROUTE DETAILS', lines)
        if self.help:
            self.modal(screen, 'KEYBOARD + MOUSE', [
                'Tab / Shift-Tab: switch view. Click tabs or period buttons.',
                '1 / 2 / 3 / 4: today / 7d / 30d / 90d. f: cycle source.',
                'Routes: j/k or arrows, PgUp/PgDn, Home/End; Enter details.',
                '/: search model/backend. s: sort. x: clear source/search.',
                'Trends: Left/Right inspect; m changes metric; click bars.',
                'Space: freeze display (collection continues). r: refresh.',
                'Esc: close overlay. ?: help. q: quit.', '',
                '1d means today from local midnight, grouped hourly.',
                'Hermes history uses session last-activity timestamps.',
                'Rates count recorded usage; they are not streamed TPS.',
                'Mouse support depends on your terminal.'])
        screen.refresh()

    def trend(self, screen, snap):
        height, width = screen.getmaxyx()
        timeline = snap['timeline']
        metric = self.METRICS[self.metric]
        self.button(screen, 8, 1, f'm:metric {metric}', 'metric')
        safe_add(screen, 8, 27, 'HOURLY / TODAY' if snap['days'] == 1 else f"DAILY / {snap['days']} DAYS", self.accent)
        if not timeline:
            return
        selected = len(timeline) - 1 if self.cursor is None else min(self.cursor, len(timeline) - 1)
        self.cursor = selected
        capacity = max(1, (width - 13) // 2)
        start = max(0, min(selected - capacity // 2, len(timeline) - capacity))
        visible = timeline[start:start + capacity]
        peak = max((v[metric] for v in timeline), default=0)
        bottom = height - 8
        chart_height = max(2, bottom - 10)
        safe_add(screen, 10, 1, compact(peak), self.dim)
        safe_add(screen, bottom, 5, '0', self.dim)
        for i, bucket in enumerate(visible):
            x = 9 + i * 2
            index = start + i
            attr = self.good if index == selected else self.accent
            filled = bucket[metric] / peak * chart_height if peak else 0
            for row in range(chart_height):
                glyph = '█' if filled >= row + 1 else '▄' if filled > row else '·' if row == 0 else ' '
                y = bottom - row
                safe_add(screen, y, x, glyph, attr)
                self.hits.append((y, x, 2, 'cursor', index))
            safe_add(screen, bottom + 1, x, '^' if index == selected else '─', attr | (curses.A_REVERSE if index == selected else 0))
            self.hits.append((bottom + 1, x, 2, 'cursor', index))
        safe_add(screen, bottom + 2, 9, visible[0]['label'], self.dim)
        last_label = visible[-1]['label']
        if len(visible) > 3:
            safe_add(screen, bottom + 2, 9 + (len(visible) - 1) * 2, last_label, self.dim)
        item = timeline[selected]
        safe_add(screen, height - 5, 2, f"{item['label']} | {metric.upper()} {item[metric]:,} | calls {item['calls']:,}", self.accent)
        safe_add(screen, height - 4, 2, f"Prompt {compact(item['prompt'])} / Out {compact(item['output'])} / Cache {compact(item['cache'])} | Hermes by last activity", self.dim)

    def sources(self, screen, snap):
        height, width = screen.getmaxyx()
        for i, name in enumerate(self.SOURCES[1:]):
            y = 8 + i * 4
            item = snap['source_status'][name]
            state = item['error'] or 'Connected'
            self.button(screen, y, 1, name, 'source_focus', i + 1)
            safe_add(screen, y, 19, state, self.good if not item['error'] else self.accent)
            safe_add(screen, y + 1, 3, f"{item['files']:,} {'usage rows' if name == 'Hermes' else 'log files'} | latest usage {short_age(item['latest'], snap['now'])}")
            rate = snap['rate']['sources'].get(name, {})
            safe_add(screen, y + 2, 3, f"Recorded prompt {rate.get('prompt_per_sec', 0):,.1f}/s | output {rate.get('output_per_sec', 0):,.1f}/s", self.dim)
        if height >= 26:
            gw = snap['source_status']['gateway']
            safe_add(screen, 21, 2, f"Hermes gateway: {gw['state']} | state {short_age(gw['latest'], snap['now'])} | agents {gw['agents']}")
        if height >= 29:
            safe_add(screen, 23, 2, 'Local usage only. Claude transport provider is not recorded.', self.dim)
            safe_add(screen, 24, 2, 'Hermes rate starts after an observed DB increment.', self.dim)


def draw_dashboard(stdscr: Any, app: RouteWatch) -> None:
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    stdscr.keypad(True)
    stdscr.timeout(150)
    ui = DashboardUI(app)
    try:
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_CYAN, -1)
        curses.init_pair(2, curses.COLOR_GREEN, -1)
        ui.accent = curses.color_pair(1) | curses.A_BOLD
        ui.good = curses.color_pair(2) | curses.A_BOLD
        curses.mousemask(curses.ALL_MOUSE_EVENTS)
        curses.mouseinterval(150)
    except curses.error:
        pass
    snap = app.snapshot(source=ui.SOURCES[ui.source])
    next_snapshot = 0
    while not app.stop_event.is_set():
        if not ui.paused and (ui.needs_snapshot or time.monotonic() >= next_snapshot):
            snap = app.snapshot(source=ui.SOURCES[ui.source])
            ui.needs_snapshot = False
            next_snapshot = time.monotonic() + 1
        ui.render(stdscr, snap)
        try:
            key = stdscr.getch()
        except curses.error:
            key = -1
        if not ui.handle(key, snap):
            break


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="routewatch",
        description="Read-only terminal monitor for local Codex, Claude Code, and Hermes routing/token telemetry.",
        epilog="Rate is based on completed usage records; none of these local sources exposes live streamed TPS.",
    )
    parser.add_argument("--days", type=int, choices=(1, 7, 30, 90), default=30, help="trend window (default: 30)")
    parser.add_argument("--refresh", type=int, default=3, help="dashboard refresh seconds (default: 3)")
    parser.add_argument("--once", action="store_true", help="print one text snapshot and exit")
    parser.add_argument("--codex-dir", type=Path, default=DEFAULT_CODEX, help=f"Codex sessions directory (default: {DEFAULT_CODEX})")
    parser.add_argument("--claude-dir", type=Path, default=DEFAULT_CLAUDE, help=f"Claude Code projects directory (default: {DEFAULT_CLAUDE})")
    parser.add_argument("--hermes-db", type=Path, default=DEFAULT_HERMES_DB, help=f"Hermes state database (default: {DEFAULT_HERMES_DB})")
    parser.add_argument("--hermes-state", type=Path, default=DEFAULT_HERMES_STATE, help=f"Hermes gateway state JSON (default: {DEFAULT_HERMES_STATE})")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if args.refresh < 1:
        print("routewatch: --refresh must be at least 1 second", file=sys.stderr)
        return 2
    app = RouteWatch(args)
    try:
        if args.once or not sys.stdout.isatty() or not sys.stdin.isatty():
            print_snapshot(app)
        else:
            curses.wrapper(draw_dashboard, app)
    except KeyboardInterrupt:
        return 130
    finally:
        app.stop_event.set()
        app.wake_event.set()
        app.worker.join(timeout=0.2)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
